{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pidgin.local/schemas/pidgin-catalog.schema.json",
  "title": "Pidgin Semantic Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "version", "concepts"],
  "properties": {
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "signature": {
      "type": "object"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pointer", "type_signature", "implementations"],
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "type_signature": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "safety_sensitive": {
            "type": "boolean"
          },
          "implementations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
