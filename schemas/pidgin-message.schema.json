{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-pidgin.local/schemas/pidgin-message.schema.json",
  "title": "Pidgin Resolve Message",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "pidgin_version",
    "message_type",
    "message_id",
    "sender_id",
    "receiver_id",
    "target_language",
    "artifact",
    "steps",
    "created_at"
  ],
  "properties": {
    "pidgin_version": {
      "const": "0.1"
    },
    "message_type": {
      "const": "resolve"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "sender_id": {
      "type": "string",
      "minLength": 1
    },
    "receiver_id": {
      "type": "string",
      "minLength": 1
    },
    "target_language": {
      "enum": ["python", "javascript"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo", "revision"],
      "properties": {
        "kind": {
          "enum": ["hf", "local", "repo"]
        },
        "repo": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)?$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_id": {
      "type": "string"
    },
    "constraints": {
      "type": "array"
    },
    "metadata": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    }
  }
}
