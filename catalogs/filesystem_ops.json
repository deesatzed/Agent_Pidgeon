      "safety_sensitive": true,
      "implementations": {
        "python": "lambda request: {'path_allowlist_required': True, 'request': request}",
        "javascript": "(request) => ({ path_allowlist_required: true, request })"
      }
    },
    {
      "pointer": "fs.block_secret_paths",
      "type_signature": "file_request -> policy_finding",
      "description": "Block file operations that target common secret, credential, or key material paths.",
      "safety_sensitive": true,
      "implementations": {
        "python": "lambda request: {'blocked': True, 'reason': 'secret path access is not allowed', 'request': request}",
        "javascript": "(request) => ({ blocked: true, reason: 'secret path access is not allowed', request })"
      }
    }
