      "pointer": "fs.read_user_file",
      "type_signature": "file_request -> read_file_request",
      "description": "Represent a proposed user-file read without performing the read.",
      "safety_sensitive": true,
      "implementations": {
        "python": "lambda request: {'action': 'read_user_file', 'request': request}",
        "javascript": "(request) => ({ action: 'read_user_file', request })"
      }
    },
    {
      "pointer": "fs.write_user_file",
      "type_signature": "file_request -> write_file_request",
      "description": "Represent a proposed user-file write without performing the write.",
      "safety_sensitive": true,
      "implementations": {
        "python": "lambda request: {'action': 'write_user_file', 'requires_backup_or_diff': True, 'request': request}",
        "javascript": "(request) => ({ action: 'write_user_file', requires_backup_or_diff: true, request })"
      }
    },
    {
      "pointer": "fs.delete_user_file",
      "type_signature": "file_request -> delete_file_request",
